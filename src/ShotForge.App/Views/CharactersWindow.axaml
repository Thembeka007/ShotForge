<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ShotForge.App.ViewModels"
        x:Class="ShotForge.App.Views.CharactersWindow"
        x:Name="CharactersRoot"
        x:DataType="vm:CharactersWindowViewModel"
        Icon="/Assets/ShotForge.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Title="Characters"
        Width="760" Height="520"
        WindowStartupLocation="CenterOwner">

  <Grid Margin="20" ColumnDefinitions="1.2*,16,*">

    <!-- LEFT: existing characters -->
    <Grid Grid.Column="0" RowDefinitions="Auto,*">

      <TextBlock Grid.Row="0" Margin="0,0,0,12" FontSize="18" FontWeight="Bold"
                 Text="{Binding ProjectDisplayName, StringFormat='Characters — {0}'}" />

      <ListBox Grid.Row="1" ItemsSource="{Binding Characters}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:CharacterListItem">
            <Border Margin="0,0,0,8" Padding="8"
                    Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4">
              <DockPanel>
                <Image DockPanel.Dock="Left"
                       Source="{Binding Thumbnail}"
                       Width="56" Height="56" Stretch="UniformToFill"
                       Margin="0,0,10,0" />
                <Button DockPanel.Dock="Right"
                        Content="Delete"
                        VerticalAlignment="Top"
                        x:CompileBindings="False"
                        Command="{Binding DataContext.DeleteCharacterCommand, ElementName=CharactersRoot}"
                        CommandParameter="{Binding}" />
                <Button DockPanel.Dock="Right"
                        Content="Edit"
                        VerticalAlignment="Top"
                        Margin="0,0,8,0"
                        x:CompileBindings="False"
                        Command="{Binding DataContext.EditCharacterCommand, ElementName=CharactersRoot}"
                        CommandParameter="{Binding}" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                  <TextBlock Text="{Binding StandingDescription}"
                             Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <!-- Vertical divider -->
    <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerBrush}" />

    <!-- RIGHT: add-character form -->
    <StackPanel Grid.Column="2" Spacing="10">

      <TextBlock Text="{Binding AddOrUpdateCharacterButtonText}" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" />

      <TextBox Watermark="Name..." Text="{Binding NewCharacterName}" />

      <TextBox Watermark="Standing description (used to keep every shot consistent)..."
               Text="{Binding NewCharacterDescription}"
               AcceptsReturn="True" Height="80" TextWrapping="Wrap" />

      <Button Content="Choose Reference Image..."
              Click="OnChooseImageClick"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

      <Border Height="140" Background="{DynamicResource ImageWellBrush}" CornerRadius="4"
              HorizontalAlignment="Stretch">
        <Image Source="{Binding PendingImagePreview}"
               Stretch="Uniform" Margin="4" />
      </Border>

      <Button Content="{Binding AddOrUpdateCharacterButtonText}"
              Command="{Binding AddCharacterCommand}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

      <Button Content="Cancel"
              Command="{Binding CancelEditCharacterCommand}"
              IsVisible="{Binding IsEditingCharacter}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

    </StackPanel>

  </Grid>

</Window>
